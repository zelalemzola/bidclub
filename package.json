{
  "name": "bidclub",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter admin run dev",
    "dev:web": "pnpm --filter web run dev",
    "dev:admin": "pnpm --filter admin run dev",
    "build": "pnpm --filter web --filter admin run build",
    "lint": "pnpm --filter web --filter admin run lint",
    "typecheck": "pnpm --filter web --filter admin run typecheck",
    "clean": "pnpm --filter web --filter admin run clean",
    "db:reset-admin": "node --env-file=.env.local scripts/reset-and-seed-admin.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
